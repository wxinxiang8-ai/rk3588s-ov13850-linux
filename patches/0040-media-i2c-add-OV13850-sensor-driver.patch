+static int ov13850_check_sensor_id(struct ov13850 *ov13850, struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	u32 id = 0;
+	int ret;
+
+	ret = ov13850_read_reg(client, OV13850_REG_CHIP_ID,
+			       OV13850_REG_VALUE_16BIT, &id);
+	if (ret) {
+		dev_err(dev, "failed to read sensor id: %d\n", ret);
+		return ret;
+	}
+
+	if (id != OV13850_CHIP_ID) {
+		dev_err(dev, "sensor id mismatch: 0x%04x != 0x%04x\n",
+			OV13850_CHIP_ID, id);
+		return -ENODEV;
+	}
+
+	ret = ov13850_read_reg(client, OV13850_CHIP_REVISION_REG,
+			       OV13850_REG_VALUE_08BIT, &id);
+	if (ret) {
+		dev_err(dev, "failed to read sensor revision: %d\n", ret);
+		return ret;
+	}
+
+	if (id == OV13850_REVISION_R1A) {
+		ov13850->global_regs = ov13850_global_regs_r1a;
+	} else if (id == OV13850_REVISION_R2A) {
+		ov13850->global_regs = ov13850_global_regs_r2a;
+	} else {
+		dev_err(dev, "sensor revision mismatch: 0x%02x\n", id);
+		return -ENODEV;
+	}
+
+	dev_info(dev, "Detected OV13850 sensor revision: 0x%02x\n", id);
+
+	return 0;
+}
