+static int ov13850_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov13850 *ov13850;
+	struct v4l2_subdev *sd;
+	int ret;
+
+	dev_info(dev, "Probing OV13850 sensor\n");
+
+	ov13850 = devm_kzalloc(dev, sizeof(*ov13850), GFP_KERNEL);
+	if (!ov13850)
+		return -ENOMEM;
+
+	ov13850->client = client;
+	ov13850->cur_mode = &supported_modes[0];
+
+	ov13850->xvclk = devm_clk_get(dev, "xvclk");
+	if (IS_ERR(ov13850->xvclk))
+		return dev_err_probe(dev, PTR_ERR(ov13850->xvclk),
+							"Failed to get xvclk\n");
+
+	ov13850->power_gpio = devm_gpiod_get_optional(dev, "power", GPIOD_OUT_LOW);
+	if (IS_ERR(ov13850->power_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov13850->power_gpio),
+							"Failed to get power GPIO\n");
+
+	ov13850->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ov13850->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov13850->reset_gpio),
+							"Failed to get reset GPIO\n");
+
+	ov13850->powerdown_gpio = devm_gpiod_get_optional(dev, "powerdown", GPIOD_OUT_LOW);
+	if (IS_ERR(ov13850->powerdown_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov13850->powerdown_gpio),
+							"Failed to get powerdown GPIO\n");
+
+	ret = ov13850_configure_regulators(ov13850);
+	if (ret) {
+		dev_err(dev, "Failed to configure regulators\n");
+		return ret;
+	}
+	ov13850->pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(ov13850->pinctrl)) {
+		ret = PTR_ERR(ov13850->pinctrl);
+		if (ret == -EPROBE_DEFER)
+			return ret;
+		dev_dbg(dev, "Failed to get pinctrl\n");
+		ov13850->pinctrl = NULL;
+	} else {
+		ov13850->pins_default = pinctrl_lookup_state(ov13850->pinctrl,
+							     PINCTRL_STATE_DEFAULT);
+		if (IS_ERR(ov13850->pins_default)) {
+			ov13850->pins_default = NULL;
+			dev_dbg(dev, "Failed to get default pinstate\n");
+		}
+		ov13850->pins_sleep = pinctrl_lookup_state(ov13850->pinctrl,
+							   PINCTRL_STATE_SLEEP);
+		if (IS_ERR(ov13850->pins_sleep)) {
+			ov13850->pins_sleep = NULL;
+			dev_dbg(dev, "Failed to get sleep pinstate\n");
+		}
+	}
+
+	mutex_init(&ov13850->mutex);
+
+	sd = &ov13850->sd;
+	v4l2_i2c_subdev_init(sd, client, &ov13850_subdev_ops);
+	ret = ov13850_init_controls(ov13850);
+	if (ret) {
+		dev_err(dev, "Failed to initialize controls\n");
+		goto err_destroy_mutex;
+	}
+
+	ret = ov13850_power_on(ov13850);
+	if (ret) {
+		dev_err(dev, "Failed to power on sensor\n");
+		goto err_free_handler;
+	}
+
+	ret = ov13850_check_sensor_id(ov13850, client);
+	if (ret) {
+		dev_err(dev, "Failed to check sensor ID\n");
+		goto err_power_off;
+	}
+
+	ret = ov13850_write_array(client, ov13850->global_regs);
+	if (ret) {
+		dev_err(dev, "Failed to initialize global registers\n");
+		goto err_power_off;
+	}
+
+	sd->internal_ops = &ov13850_internal_ops;
+	sd->flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+
+#if defined(CONFIG_MEDIA_CONTROLLER)
+	sd->entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov13850->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sd->entity, 1, &ov13850->pad);
+	if (ret < 0) {
+		dev_err(dev, "Failed to init media entity pads\n");
+		goto err_power_off;
+	}
+#endif
+
+	snprintf(sd->name, sizeof(sd->name), "%s %s",
+		 OV13850_NAME, dev_name(sd->dev));
+
+	ret = v4l2_async_register_subdev_sensor(sd);
+	if (ret) {
+		dev_err(dev, "v4l2 async register subdev failed\n");
+		goto err_clean_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_clean_entity:
+#if defined(CONFIG_MEDIA_CONTROLLER)
+	media_entity_cleanup(&sd->entity);
+#endif
+err_power_off:
+	ov13850_power_off(ov13850);
+err_free_handler:
+	v4l2_ctrl_handler_free(&ov13850->ctrl_handler);
+err_destroy_mutex:
+	mutex_destroy(&ov13850->mutex);
+
+	return ret;
+}
+
+static void ov13850_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov13850 *ov13850 = to_ov13850(sd);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		ov13850_power_off(ov13850);
+	pm_runtime_set_suspended(&client->dev);
+
+	v4l2_async_unregister_subdev(sd);
+#if defined(CONFIG_MEDIA_CONTROLLER)
+	media_entity_cleanup(&sd->entity);
+#endif
+	v4l2_ctrl_handler_free(&ov13850->ctrl_handler);
+	mutex_destroy(&ov13850->mutex);
+}
