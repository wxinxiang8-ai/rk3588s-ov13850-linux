+static int ov13850_read_reg(struct i2c_client *client, u16 reg, u32 len, u32 *val)
+{
+	struct i2c_msg msgs[2];
+	__be32 data_be = 0;
+	__be16 reg_addr_be = cpu_to_be16(reg);
+	u8 *data_be_p = (u8 *)&data_be;
+	int ret;
+
+	if (len > 4 || !len)
+		return -EINVAL;
+
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = sizeof(reg_addr_be);
+	msgs[0].buf = (u8 *)&reg_addr_be;
+
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = &data_be_p[sizeof(data_be) - len];
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret < 0)
+		return ret;
+	if (ret != ARRAY_SIZE(msgs))
+		return -EIO;
+
+	*val = be32_to_cpu(data_be);
+
+	return 0;
+}
+
+static int ov13850_write_reg(struct i2c_client *client, u16 reg, u32 len, u32 val)
+{
+	u32 buf_i, val_i;
+	u8 buf[6];
+	__be32 val_be;
+	const u8 *val_p;
+	int ret;
+
+	dev_dbg(&client->dev, "writing reg 0x%04x val 0x%02x\n", reg, val);
+
+	if (len > 4 || !len)
+		return -EINVAL;
+
+	buf[0] = reg >> 8;
+	buf[1] = reg & 0xff;
+
+	val_be = cpu_to_be32(val);
+	val_p = (u8 *)&val_be;
+	buf_i = 2;
+	val_i = 4 - len;
+
+	while (val_i < 4)
+		buf[buf_i++] = val_p[val_i++];
+
+	ret = i2c_master_send(client, buf, len + 2);
+	if (ret < 0)
+		return ret;
+	if (ret != len + 2)
+		return -EIO;
+
+	return 0;
+}
+
+static int ov13850_write_array(struct i2c_client *client, const struct ov13850_reg *regs)
+{
+	u32 i;
+	int ret = 0;
+
+	for (i = 0; ret == 0 && regs[i].addr != OV13850_REG_NULL; i++)
+		ret = ov13850_write_reg(client, regs[i].addr,
+					OV13850_REG_VALUE_08BIT,
+					regs[i].val);
+
+	return ret;
+}
